#!/usr/bin/env bash
# Proactive anomaly alerts (opt-in, DETERMINISTIC — no agent/LLM call, no plan
# usage). Every proactive_alerts_interval_minutes we fetch all HA states from the
# Supervisor API ourselves and run a handful of fixed, rule-based checks (low
# battery, water leak, door/window open at night, temperature out of band, high
# CO2, and a watched device/internet gateway going offline). When an entity NEWLY
# enters an anomaly we push one batched ha-notify; a still-active
# anomaly is remembered in /data/alerts-state.json so it doesn't re-notify every
# cycle, and is dropped when it clears so it can alert again next time.
# A threshold alert that is active clears only once the value is back past its
# threshold by that rule's margin, so a reading that hovers at the threshold is
# one alert, not many.
#
# Unlike cc-monitor / cc-digest this spends NO plan usage — it is pure bash + jq,
# so there is no model and thus no prompt-injection surface. SUPERVISOR_TOKEN is
# used ONLY for the Supervisor states curl.
#
# Test hooks (never used in production):
#   cc-alerts --once           run exactly one check cycle and exit
#   CC_ALERTS_ONCE=1           same as --once
#   CC_ALERTS_STATES_FILE=path read states from a JSON fixture instead of curl
#   CC_ALERTS_DATA_DIR=dir     override /data (options.json + state file) for isolation
#   CC_ALERTS_NOW=HH:MM        override "now" for the night-window / quiet-hours logic
#   CC_ALERTS_INTERVAL_MINUTES override the loop sleep (the run script passes this)
#   CC_ALERTS_NOTIFY_CMD=cmd   override the notifier (default ha-notify) for asserting output
set -o pipefail
export HOME=/data/home
# Production dirs first; the inherited PATH is appended so the tests can find jq
# etc. on a dev machine (e.g. Homebrew paths) without affecting the container.
export PATH="/data/home/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH}"

NOTIFY_CMD="${CC_ALERTS_NOTIFY_CMD:-ha-notify}"
# shellcheck source-path=SCRIPTDIR source=../lib/addon-branding.sh
source "${BASH_SOURCE[0]%/*}/../lib/addon-branding.sh"
# shellcheck source-path=SCRIPTDIR source=../lib/ha-curl.sh
source "${BASH_SOURCE[0]%/*}/../lib/ha-curl.sh"
# shellcheck source-path=SCRIPTDIR source=../lib/ha-anomalies.sh
source "${BASH_SOURCE[0]%/*}/../lib/ha-anomalies.sh"

DATA_DIR="${CC_ALERTS_DATA_DIR:-/data}"
OPTIONS="${DATA_DIR}/options.json"
STATE="${DATA_DIR}/alerts-state.json"

log() { printf '[cc-alerts] %s\n' "$1" >&2; }

# --- Config (from options.json, with sensible built-in defaults) ------------
enabled="$(jqopt '.proactive_alerts' false)"
[ "${enabled}" = "true" ] || exit 0   # master switch off/absent → do nothing

interval="${CC_ALERTS_INTERVAL_MINUTES:-$(jqopt '.proactive_alerts_interval_minutes' 15)}"
[ "${interval}" -ge 1 ] 2>/dev/null || interval=15

load_alert_options

# An empty list is a correct configuration, and it is also the one state in which
# this check can never say anything — so from outside "watching, and all clear"
# and "watching nothing" look identical: the offline alert is on, the list is
# empty, and nothing is ever reported either way. Said once at start-up, on the
# same channel the other two loops log to. The behaviour above is unchanged; the
# empty list still watches nothing, deliberately, for the reason stated there.
if [ "${offline_enabled}" = "true" ] && [ "${offline_entities}" = '[]' ]; then
    log "offline watch: no entities configured (alert_offline_entities is empty)"
fi
quiet="$(jqopt '.alert_quiet_hours' '')"             # "" = off, else "HH:MM-HH:MM"

# --- Clear margins (hysteresis) ----------------------------------------------
# How far back past its threshold a value must be before an ACTIVE alert clears;
# 0 clears it as soon as the value is no longer past the threshold. Raising an
# alert never depends on the margin. A margin under which an alert could never
# clear counts as 0.
margin() {  # $1=option $2=default $3=threshold(s), a JSON array $4=jq test of $m against them $5=rule on
    local value
    [ "$5" = "true" ] || { printf '0'; return; }
    value="$(jqopt ".$1" "$2")"
    if ! jq -en --arg m "${value}" --argjson t "$3" \
        "(\$m | tonumber) as \$m | \$m >= 0 and (\$m == 0 or ($4))" >/dev/null 2>&1; then
        log "$1: ${value} is negative, not a number, or too wide for an alert to clear; using 0"
        value=0
    fi
    printf '%s' "${value}"
}
on_above_zero() { if [ "$1" -gt 0 ] 2>/dev/null; then printf 'true'; else printf 'false'; fi; }
batt_margin="$(margin alert_battery_margin 0 "[${batt_below}]" '$t[0] + $m <= 100' "$(on_above_zero "${batt_below}")")"
temp_margin="$(margin alert_temp_margin 0 "[${temp_low},${temp_high}]" '2 * $m < $t[1] - $t[0]' "${temp_enabled}")"
co2_margin="$(margin alert_co2_margin 100 "[${co2_above}]" '$m < $t[0]' "$(on_above_zero "${co2_above}")")"
humidity_margin="$(margin alert_humidity_margin 0 "[${humidity_low},${humidity_high}]" '2 * $m < $t[1] - $t[0]' "${humidity_enabled}")"

# --- One check cycle --------------------------------------------------------
run_cycle() {
    local now_hm states anomalies_json prev_active prev_sides is_quiet result msg

    now_hm="${CC_ALERTS_NOW:-$(date +%H:%M)}"

    is_quiet=false
    if [ -n "${quiet}" ] && [[ "${quiet}" == *-* ]]; then
        if in_window "${now_hm}" "${quiet%%-*}" "${quiet#*-}"; then is_quiet=true; fi
    fi

    # Fetch the (untrusted) states — from a fixture in tests, else the Supervisor.
    if [ -n "${CC_ALERTS_STATES_FILE:-}" ]; then
        states="$(cat "${CC_ALERTS_STATES_FILE}" 2>/dev/null)"
    else
        states="$(ha_curl "${SUPERVISOR_TOKEN}" -sS \
            http://supervisor/core/api/states 2>/dev/null)"
    fi

    # What was active after the last cycle: the keys (dedupe and hysteresis) and,
    # for a rule with two thresholds, the side that holds each alert.
    prev_active="$(jq -c '.active // [] | arrays' "${STATE}" 2>/dev/null)"
    [ -n "${prev_active}" ] || prev_active="[]"
    prev_sides="$(jq -c '[.items[]? | select(.side) | {(.key): .side}] | add // {}' "${STATE}" 2>/dev/null)"
    [ -n "${prev_sides}" ] || prev_sides="{}"

    # Deterministic anomaly detection. Every entry degrades to `empty` on bad
    # fields, so one malformed state never breaks the array (or the loop).
    anomalies_json="$(printf '%s' "${states}" \
        | classify_anomalies "${now_hm}" "${prev_active}" "${prev_sides}")" || {
        # No list of states (a failed or cut-off fetch, an error body) is no
        # reading. Taking it for "nothing is wrong" would clear every active
        # alert, and each would then notify again.
        log "states: no usable reading this cycle; the active alerts are unchanged"
        return 0
    }

    # Diff: notify only NEWLY-appeared anomalies. During quiet hours, non-critical
    # ones are suppressed AND kept out of the active set, so they stay pending and
    # fire once quiet hours end (rather than being lost or storming every cycle).
    result="$(jq -nc \
        --argjson anom "${anomalies_json}" \
        --argjson prev "${prev_active}" \
        --argjson quiet "${is_quiet}" '
        ($anom | map(select((.key as $k | $prev | index($k)) | not))) as $newly
        | ($newly | map(select(.critical or ($quiet | not))))            as $to_notify
        | ($newly | map(select(($quiet) and (.critical | not)) | .key))  as $suppressed
        | { notify: ($to_notify | map(.line)),
            active: (($anom | map(.key)) - $suppressed),
            # items: the SAME active set as above, but the full anomaly objects
            # (key/critical/line) instead of bare keys — persisted so the prompt
            # server can serve them on /api/status without re-running detection.
            items: ($anom | map(select(.key as $k | ($suppressed | index($k)) | not))) }' 2>/dev/null)"
    [ -n "${result}" ] || return 0

    # Persist the new active set (0600 — no secrets, but keep it tidy/private).
    local tmp
    tmp="$(mktemp 2>/dev/null)"
    # stderr first: bash applies redirections left to right, and the file may not open.
    if printf '%s\n' "${result}" | jq -c '{active: .active, items: .items}' 2>/dev/null > "${tmp}"; then
        chmod 600 "${tmp}"
        mv "${tmp}" "${STATE}"
    else
        rm -f "${tmp}"
    fi

    # One batched notification for everything new this cycle.
    msg="$(printf '%s' "${result}" | jq -r 'if (.notify | length) > 0 then (.notify | join("\n")) else empty end' 2>/dev/null)"
    if [ -n "${msg}" ]; then
        "${NOTIFY_CMD}" "${msg}" "$(branding_name_or_fallback agentName) · Home alert" >/dev/null 2>&1 || true
    fi
}

# --- Entry point ------------------------------------------------------------
mkdir -p "${DATA_DIR}"

once=0
[ "${1:-}" = "--once" ] && once=1
[ "${CC_ALERTS_ONCE:-0}" = "1" ] && once=1

if [ "${once}" = "1" ]; then
    run_cycle
    exit 0
fi

sleep 120  # let the console and login settle after boot

while true; do
    run_cycle || true
    sleep "$(( interval * 60 ))"
done
