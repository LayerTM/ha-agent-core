#!/usr/bin/env bash
# Query Home Assistant entity state(s).
#   ha-state                 → list all entity_ids
#   ha-state <entity_id>     → full state JSON for one entity
#   ha-state <domain.>       → all entities in a domain (e.g. ha-state light.)
set -o pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/ha-curl.sh
source "${BASH_SOURCE[0]%/*}/../lib/ha-curl.sh"
API="http://supervisor/core/api"

arg="${1:-}"
if [ -z "${arg}" ]; then
    ha_curl "${SUPERVISOR_TOKEN}" -sS "${API}/states" | jq -r '.[].entity_id' | sort
elif [[ "${arg}" == *. ]]; then
    # domain mode: "light." → all light.* entities
    domain="${arg%.}"
    ha_curl "${SUPERVISOR_TOKEN}" -sS "${API}/states" \
        | jq --arg d "${domain}" '[.[] | select(.entity_id | startswith($d + "."))]'
else
    ha_curl "${SUPERVISOR_TOKEN}" -sS "${API}/states/${arg}" | jq .
fi
