{
  "name": "{{productName}}",
  "short_name": "{{productName}}",
  "description": "{{productName}} console for Home Assistant",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "{{theme.ui.appBackground}}",
  "theme_color": "{{theme.ui.appBackground}}",
  "icons": [
    { "src": "icons/pwa-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/pwa-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
