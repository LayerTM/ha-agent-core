{
  "name": "claude-console",
  "version": "1.0.0",
  "private": true,
  "description": "Web console serving the Claude Code CLI for the Home Assistant add-on",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node test-support/hermetic-test.js node --test \"test/**/*.test.js\"",
    "test:alerts": "node test-support/hermetic-test.js bash test/cc-alerts.test.sh",
    "test:config": "node test-support/hermetic-test.js bash test/config-list.test.sh",
    "test:curl": "node test-support/hermetic-test.js bash test/ha-curl.test.sh",
    "test:ready": "node test-support/hermetic-test.js bash test/ha-core-ready.test.sh",
    "test:image": "node test-support/hermetic-test.js bash test/image.test.sh",
    "test:monitor": "node test-support/hermetic-test.js bash test/cc-monitor.test.sh",
    "test:digest": "node test-support/hermetic-test.js bash test/cc-digest.test.sh",
    "test:audit": "node test-support/hermetic-test.js bash test/cc-hook-audit.test.sh",
    "test:usage": "node test-support/hermetic-test.js bash test/ha-usage.test.sh",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "busboy": "1.6.0",
    "express": "5.3.0",
    "node-pty": "1.1.0",
    "ws": "8.22.1"
  },
  "allowScripts": {
    "node-pty": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
